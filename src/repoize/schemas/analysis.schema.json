{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LQDC3417/repoize/main/src/repoize/schemas/analysis.schema.json",
  "title": "Repoize Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "project_name",
    "project_path",
    "primary_language",
    "languages",
    "profile",
    "frameworks",
    "dependencies",
    "commands",
    "existing_configs",
    "env_info",
    "has_tests",
    "test_framework",
    "has_ci",
    "agent_ready_score",
    "agent_ready_label",
    "code_quality_score",
    "code_quality_label",
    "quality_metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_name": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "primary_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "commands": {
      "$ref": "#/$defs/commands"
    },
    "existing_configs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/config_status"
      }
    },
    "env_info": {
      "$ref": "#/$defs/env_info"
    },
    "has_tests": {
      "type": "boolean"
    },
    "test_framework": {
      "type": [
        "string",
        "null"
      ]
    },
    "has_ci": {
      "type": "boolean"
    },
    "agent_ready_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "agent_ready_label": {
      "type": "string"
    },
    "code_quality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "code_quality_label": {
      "type": "string"
    },
    "quality_metrics": {
      "$ref": "#/$defs/quality_metrics"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dependency": {
      "type": "object",
      "required": [
        "name",
        "version_spec",
        "dev"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version_spec": {
          "type": "string"
        },
        "dev": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": [
        "build",
        "test",
        "lint",
        "format",
        "run"
      ],
      "properties": {
        "build": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lint": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "config_status": {
      "type": "object",
      "required": [
        "name",
        "config_type",
        "exists",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "config_type": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "env_info": {
      "type": "object",
      "required": [
        "system",
        "arch",
        "shell",
        "dev_env_vars",
        "tools",
        "path_entries"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        },
        "dev_env_vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2
          }
        },
        "path_entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "quality_metrics": {
      "type": "object",
      "required": [
        "total_files",
        "total_lines",
        "code_lines",
        "comment_lines",
        "blank_lines",
        "files_by_language",
        "lines_by_language",
        "avg_function_length",
        "max_function_length",
        "duplicate_files",
        "duplicate_lines",
        "quality_tools_found",
        "quality_config_found"
      ],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "total_lines": {
          "type": "integer",
          "minimum": 0
        },
        "code_lines": {
          "type": "integer",
          "minimum": 0
        },
        "comment_lines": {
          "type": "integer",
          "minimum": 0
        },
        "blank_lines": {
          "type": "integer",
          "minimum": 0
        },
        "files_by_language": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "lines_by_language": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "avg_function_length": {
          "type": "number",
          "minimum": 0
        },
        "max_function_length": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_files": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_lines": {
          "type": "integer",
          "minimum": 0
        },
        "quality_tools_found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_config_found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
